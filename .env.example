# ====================================
# TenantOps Root Environment Variables
# (used by docker-compose.dev.yml)
# ====================================

# PostgreSQL
DB_USER=tenantops
DB_PASSWORD=password
DB_NAME=tenantops_dev
DB_AUTH_NAME=tenantops_auth
DB_URL=postgresql://tenantops:password@postgres:5432/tenantops_dev

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@redis:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# CORS
CORS_ORIGIN=http://localhost:5173

# Application
APP_URL=http://localhost:5173
API_URL=http://localhost:13000
NODE_ENV=development
